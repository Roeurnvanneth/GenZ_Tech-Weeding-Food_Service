generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  phone         String    @unique
  role          Role      @default(USER)

  otpCode       String?
  otpExpiry     DateTime?

  refreshToken  String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  ADMIN
  USER
}



// --- Keep this one ---
model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  title         String?
  maxPrice      Float    @default(0)
  hallPrice     Float    @default(0)
  videoUrl      String?
  images        String[]
  translations  Json
  isPoppular    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoryId    Int
  category      Category @relation(fields: [categoryId], references: [id])
}

model TeamMember {
  id           Int      @id @default(autoincrement())
  slug         String       @unique
  image        String       // Image URL for the team member photo
  translations Json         // { en: { name, role }, km: { name, role } }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Booking {
  id              Int      @id @default(autoincrement())
  customerName    String
  phoneNumber     String
  programType     String
  programDate     String
  // ADD THESE MISSING FIELDS BELOW:
  programTime     String?   // Added
  startDateTime   String?   // Added
  endDateTime     String?   // Added
  contactMethod   String?   // Added
  translations Json       // { kh: { name }, en: { name } }
  // -------------------------
  location        String
  guestCount      Int
  hasFood         Boolean  @default(false)
  hasTent         Boolean  @default(false)
  totalPrice      Float
  serviceType     String
  status          String   @default("Pending")
  createdAt       DateTime @default(now())
  foodProductId  Int?
  foodProduct    Product? @relation("FoodService", fields: [foodProductId], references: [id])
  
  tentProductId  Int?
  tentProduct    Product? @relation("TentService", fields: [tentProductId], references: [id])
}

