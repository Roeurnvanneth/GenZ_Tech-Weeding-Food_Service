generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- USER MANAGEMENT ---
model User {
  id           Int       @id @default(autoincrement())
  name         String?
  phone        String    @unique
  role         Role      @default(USER)
  carts    Cart[]
  otpCode      String?
  otpExpiry    DateTime?
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[] // ភ្ជាប់ទៅកាន់ការកក់របស់ User ម្នាក់ៗ
}

enum Role {
  ADMIN
  USER
}

// --- PRODUCT & CATEGORY ---
model Category {
  id           Int       @id @default(autoincrement())
  description  String?
  name         String
  slug         String    @unique
  isPoppular   Boolean   @default(false)
  translations Json
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  menus Menu[]
}

model Product {
  id           Int      @id @default(autoincrement())
  title        String
  price        Float    @default(0)
  slug         String   @unique
  maxPrice     Float    @default(0)
  hallPrice    Float    @default(0)
  isPoppular   Boolean  @default(false)
  videoUrl     String?
  images       Json
  translations Json
  categoryId   Int
  category     Category @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TeamMember {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  image        String
  translations Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}



// --- CATERING & MENU SYSTEM ---
model EventType {
  id   Int    @id @default(autoincrement())
  name String @unique

  // នេះជាអ្វីដែលប្អូនមានរួចហើយ
  cateringItems CateringItem[]

  // ប្រសិនបើប្អូនចង់ឱ្យ Catering ផ្ទាល់ភ្ជាប់ទៅ EventType ដែរ (Optional)
  caterings Catering[]
}

model Menu {
  id        Int     @id @default(autoincrement())
  menu_name String
  image     String? @default("default-food.jpg")
  price_usd Decimal @default(0) @db.Decimal(10, 2)
  price_khr Decimal @default(0) @db.Decimal(10, 2)
  status    String  @default("active")

  // ការតភ្ជាប់ទៅ Category
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  // Relations
  pricings      MenuPricing[]
  cateringItems CateringItem[] // ម្ហូបមួយមុខ អាចនៅក្នុង Catering ច្រើន

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- CATERING & EVENT SYSTEM ---

model MenuPricing {
  id             Int           @id @default(autoincrement())
  menu_id        Int
  price_usd      Decimal       @db.Decimal(10, 2)
  price_khr      Decimal       @db.Decimal(10, 2)
  status         String        @default("active")
  effective_from DateTime      @default(now())
  menu           Menu          @relation(fields: [menu_id], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  price        Decimal       @db.Decimal(10, 2)
  bookingItems   BookingItem[]
}



model CateringStandard {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  caterings Catering[]
}

model Catering {
  id          Int      @id @default(autoincrement())
  name        String   // ឈ្មោះឈុត ឧទាហរណ៍: "Wedding Gold Package"
  description String?
  totalPrice  Decimal  @db.Decimal(10, 2) @map("total_price")

  // ការតភ្ជាប់ទៅ Standard (Gold, Silver...)
  cateringStandardId Int              @map("catering_standard_id")
  standard           CateringStandard @relation(fields: [cateringStandardId], references: [id])

  // ការតភ្ជាប់ទៅ EventType (Wedding, Funeral...)
  eventTypeId Int       @map("event_type_id")
  eventType   EventType @relation(fields: [eventTypeId], references: [id])

  // ទំនាក់ទំនងជាមួយ Items និង Bookings
  items    CateringItem[]
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("caterings")
}

model CateringItem {
  id           Int      @id @default(autoincrement())
  
  cateringId   Int      // ប្រើ camelCase ឱ្យដូចក្នុងកូដ
  catering     Catering @relation(fields: [cateringId], references: [id], onDelete: Cascade)

  menuId       Int      // ប្រើ camelCase ឱ្យដូចក្នុងកូដ
  menu         Menu     @relation(fields: [menuId], references: [id])

  eventTypeId  Int
  eventType    EventType @relation(fields: [eventTypeId], references: [id])

  @@unique([cateringId, menuId])
}
// --- ផ្នែក Cart (កន្ត្រកទំនិញ) ---
model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id])
  sessionId String?     // សម្រាប់ភ្ញៀវដែលមិនទាន់ Login
  items     CartItem[]
  createdAt DateTime   @default(now())
}

model CartItem {
  id              Int         @id @default(autoincrement())
  cartId          Int
  cart            Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menu_pricing_id Int         // ភ្ជាប់ទៅ MenuPricing
  menuPricing     MenuPricing @relation(fields: [menu_pricing_id], references: [id])
  quantity        Int         @default(1)
  price           Decimal     @db.Decimal(10, 2) // តម្លៃនៅពេល Add
}

// --- ផ្នែក Booking (ការកក់) ---
model Booking {
  id            Int           @id @default(autoincrement())
  customerName  String   
  phoneNumber   String    
  userId        Int?
  user          User?      @relation(fields: [userId], references: [id])
  
  // ព័ត៌មានកម្មវិធី
  programDate   DateTime
  event_date    DateTime
  startDateTime DateTime?
  endDateTime   DateTime?
  
  location      String
  guestCount    Int
  totalPrice    Decimal       @db.Decimal(10, 2)
  status        String        @default("Pending")

  catering_id   Int?
  catering      Catering?     @relation(fields: [catering_id], references: [id])
  bookingItems  BookingItem[]
  
  createdAt     DateTime      @default(now())
}

model BookingItem {
  id              Int         @id @default(autoincrement())
  booking_id      Int
  booking         Booking     @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  menu_pricing_id Int
  menuPricing     MenuPricing @relation(fields: [menu_pricing_id], references: [id])
  quantity        Int         @default(1)
  price           Decimal     @db.Decimal(10, 2)
}