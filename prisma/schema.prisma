generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String?
  phone        String    @unique
  role         Role      @default(USER)
  otpCode      String?
  otpExpiry    DateTime?
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum Role {
  ADMIN
  USER
}

model TeamMember {
  id           Int      @id @default(autoincrement())
  name  String  @default("")
  role  String  @default("")
  slug         String   @unique
  image        String
  translations Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}




model EventType {
  id                   Int                 @id @default(autoincrement())
  event_type_name_en   String
  event_type_name_kh   String
  cover_image                 String?

  // Relations
  cateringStandards    CateringStandard[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model CateringStandard {
  id                          Int                       @id @default(autoincrement())
  event_type_id               Int
  catering_standard_name_en   String
  catering_standard_name_kh   String
  cover_image                 String?
  is_special                  Boolean                   @default(false)
  description                 String?

  // Relations
  eventType                   EventType                 @relation(fields: [event_type_id], references: [id], onDelete: Cascade)
  items                       CateringStandardItem[]

  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  @@index([event_type_id])
}

model CateringStandardItem {
  id                     Int             @id @default(autoincrement())
  catering_standard_id   Int
  menu_item_id           Int
  price_usd              Float
  price_khr              Float

  // Relations
  cateringStandard       CateringStandard @relation(fields: [catering_standard_id], references: [id], onDelete: Cascade)
  menuItem               MenuItem         @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)

  createdAt              DateTime         @default(now())

  // Prevent duplicate same menu in same set
  @@unique([catering_standard_id, menu_item_id])
}

model MenuItem {
  id                     Int                     @id @default(autoincrement())
  menu_item_name_en      String
  menu_item_name_kh      String
  cover_image                 String?

  // Relations
  cateringItems          CateringStandardItem[]
  gallery                MenuItemGallery[]

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model MenuItemGallery {
  id            Int       @id @default(autoincrement())
  menu_item_id  Int
  image        String?

  // Relations
  menuItem      MenuItem  @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@index([menu_item_id])
}
