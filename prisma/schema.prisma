generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  phone         String    @unique
  role          Role      @default(USER)

  otpCode       String?
  otpExpiry     DateTime?

  refreshToken  String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  ADMIN
  USER
}



model Category {
  id           Int    @id @default(autoincrement())
  slug         String  @unique
  isPoppular    Boolean @default(false)
  translations Json
  createdAt    DateTime @default(now())
  updatedAt DateTime @updatedAt
  products     Product[]

}

model Product {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  maxPrice     Float    @default(0) // ត្រូវតែមាន Column នេះ
  hallPrice    Float    @default(0) // 💡 តម្លៃជួលរោង/សាល (បន្ថែមថ្មី)
  isPoppular   Boolean  @default(false)
  videoUrl     String?
  images       Json     // សម្រាប់រក្សាទុក Array ["url1", "url2", ...]
  translations Json
  categoryId   Int
  category     Category @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TeamMember {
  id           Int      @id @default(autoincrement())
  slug         String       @unique
  image        String       // Image URL for the team member photo
  translations Json         // { en: { name, role }, km: { name, role } }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Booking {
  id              Int      @id @default(autoincrement())
  customerName    String
  phoneNumber     String
  programType     String   
  programDate     String   
  // ADD THESE MISSING FIELDS BELOW:
  programTime     String?   // Added
  startDateTime   String?   // Added
  endDateTime     String?   // Added
  contactMethod   String?   // Added
  translations Json       // { kh: { name }, en: { name } }
  // -------------------------
  location        String
  guestCount      Int      
  hasFood         Boolean  @default(false)
  hasTent         Boolean  @default(false)
  totalPrice      Float    
  serviceType     String   
  status          String   @default("Pending")
  createdAt       DateTime @default(now())
}

